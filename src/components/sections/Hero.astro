---
import Info from "../sections/Info.astro";
import Image from "@/components/Image.astro";
import type { CV } from "@/types/cv";

interface Props {
  basics: CV["basics"];
}

const { basics } = Astro.props;
const { language, name, label, location, profiles, phone, email } = basics;
// console.log(basics)
---

<div class="container">
  <Info
    language={language}
    name={name}
    email={email}
    phone={phone}
    profiles={profiles}
    location={location}
    label={label}
  />
  <figure>
    <a href="/" data-astro-prefetch>
      <Image />
    </a>
  </figure>
</div>

<style>
  .container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
    max-width: 1000px;
    padding: 1rem;
  }

  @media (width <= 700px) {
    .container {
      flex-direction: column-reverse;
      justify-content: center;
      align-items: center;
    }
  }

  @media (width <= 700px) {
    figure { position: relative; isolation: isolate; }
    figure::after {
      content: "";
      position: absolute;
      inset: 12px -10px -10px 12px;
      border: 2px solid var(--accent);
      border-radius: 18px;
      z-index: -1;
      opacity: 0.7;
    }
    figure img {
      border-radius: 18px;
      filter: saturate(0.88) contrast(1.04);
      box-shadow: 0 18px 35px var(--color-box-shadow);
    }
  }
</style>
